{
  "name": "@lobe/ui-agent",
  "version": "1.0.0",
  "description": "Enterprise-grade LLM application component library with high availability, extensibility, and performance",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "docs:dev": "dumi dev",
    "docs:build": "dumi build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "llm",
    "ai",
    "chat",
    "agent",
    "ui",
    "components",
    "typescript"
  ],
  "author": "Lobe Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@lobehub/ui": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "ai": "^3.0.0",
    "immer": "^10.0.0",
    "react-window": "^1.8.8",
    "styled-components": "^6.1.19",
    "zod": "^3.22.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.9",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "2.1.5",
    "antd": "5.26.7",
    "dumi": "^2.4.21",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.0",
    "open": "^10.0.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "5.4.19",
    "vite-plugin-dts": "^3.7.3",
    "vitest": "2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-ui-agent.git"
  },
  "bugs": {
    "url": "https://github.com/lobehub/lobe-ui-agent/issues"
  },
  "homepage": "https://github.com/lobehub/lobe-ui-agent#readme"
}