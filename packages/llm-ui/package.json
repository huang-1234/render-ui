{
  "name": "@lobe/ui-agent",
  "version": "1.0.0",
  "description": "Enterprise-grade LLM application component library with high availability, extensibility, and performance",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "docs:dev": "dumi dev",
    "docs:build": "dumi build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "llm",
    "ai",
    "chat",
    "agent",
    "ui",
    "components",
    "typescript"
  ],
  "author": "Lobe Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@lobehub/ui": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "ai": "^3.0.0",
    "immer": "^10.0.0",
    "react-window": "^1.8.8",
    "styled-components": "^6.0.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dumi": "^2.2.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "ts-jest": "^29.1.0",
    "tsup": "^7.2.0",
    "typescript": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-ui-agent.git"
  },
  "bugs": {
    "url": "https://github.com/lobehub/lobe-ui-agent/issues"
  },
  "homepage": "https://github.com/lobehub/lobe-ui-agent#readme"
